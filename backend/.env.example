# =============================================================================
# AI Accessibility Assistant - Environment Configuration
# =============================================================================
# Copy this file to .env and configure your settings.
# Never commit .env to version control.

# --- Server ---
HOST=0.0.0.0
PORT=8000
DEBUG=true

# --- Database ---
DATABASE_URL=sqlite:///./storage/accessibility.db

# --- File Upload ---
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=./storage/uploads
PROCESSED_DIR=./storage/processed
AUDIO_DIR=./storage/audio

# --- AI Models ---
# YOLO model path (custom trained model)
YOLO_MODEL_PATH=./models/custom/best.pt
# Fallback to pretrained if custom not found
YOLO_PRETRAINED_PATH=./models/pretrained/yolo11n.pt
YOLO_CONFIDENCE_THRESHOLD=0.25

# PaddleOCR
OCR_LANG=en
OCR_USE_GPU=false

# Vision-Language Model
VLM_MODEL_NAME=vikhyatk/moondream2
VLM_DEVICE=cpu

# --- LLM Configuration ---
# Provider: "local" (Ollama), "none" (rule-based only), or "external"
LLM_PROVIDER=none
# For local Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=tinyllama

# Optional external LLM (not required - only if user configures)
# EXTERNAL_LLM_API_KEY=
# EXTERNAL_LLM_BASE_URL=
# EXTERNAL_LLM_MODEL=

# --- Piper TTS ---
PIPER_VOICE=en_US-lessac-medium
PIPER_VOICES_DIR=./models/pretrained/piper_voices
PIPER_SAMPLE_RATE=22050

# --- Data Retention ---
# Days to keep uploaded files (0 = keep forever)
DATA_RETENTION_DAYS=30

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Logging ---
LOG_LEVEL=INFO

